{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "marmitas-api",
    "Audience": "marmitas-clients",
    "Key": "",
    "ExpirationMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "https://marmitas-api.azurewebsites.net",
      "http://localhost:5173",
      "http://localhost:5000"
    ]
  },
  "RateLimiting": {
    "PermitPerMinute": 100
  },
  "Payments": {
    "DefaultGateway": "MercadoPago",
    "WebhookSecret": ""
  },
  "AllowedHosts": "*"
}
