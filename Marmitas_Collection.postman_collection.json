{
	"info": {
		"_postman_id": "7d9b9a6b-c7c4-4b53-b31f-0e1234567890",
		"name": "Marmitas API - Fluxo Principal",
		"description": "Collection configurada para o fluxo principal da plataforma. O endpoint de Login automaticamente salva o Token JWT nas variáveis globais do Postman para que as outras rotas funcionem sem você precisar copiar e colar o token toda vez.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Autenticação",
			"item": [
				{
					"name": "Registro de Cliente",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Cliente Teste\",\n  \"email\": \"cliente@teste.com\",\n  \"phone\": \"11999999999\",\n  \"password\": \"SenhaForte123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/registro",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"registro"
							]
						}
					}
				},
				{
					"name": "Fazer Login (Salva Token Automático)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.accessToken) {",
									"    pm.environment.set(\"jwt_token\", jsonData.accessToken);",
									"    pm.environment.set(\"user_id\", jsonData.user.id);",
									"    console.log(\"Token salvo com sucesso!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"cliente@teste.com\",\n  \"password\": \"SenhaForte123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Restaurantes e Cardápio",
			"item": [
				{
					"name": "Listar Restaurantes",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/restaurantes",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"restaurantes"
							]
						}
					}
				},
				{
					"name": "Ver Cardápio do Restaurante",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/restaurantes/COLOQUE-O-ID-AQUI/cardapio",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"restaurantes",
								"COLOQUE-O-ID-AQUI",
								"cardapio"
							]
						}
					}
				}
			]
		},
		{
			"name": "3. Pedidos",
			"item": [
				{
					"name": "Criar Pedido",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"restaurantId\": \"COLOQUE-O-ID-AQUI\",\n  \"items\": [\n    {\n      \"productId\": \"COLOQUE-O-ID-DO-PRODUTO\",\n      \"quantity\": 2\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/pedidos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"pedidos"
							]
						}
					}
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://localhost:7013",
			"type": "string"
		}
	]
}

